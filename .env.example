# Copy to .env and edit. Never commit the real .env.

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///attendance.db

# --- Geofence ---
GEOFENCE_RADIUS_METERS=10
ACCURACY_CREDIT_METERS=35
MAX_ACCURACY_METERS=50

# --- Teacher-anchored geofence ---
# Centre the circle on where the teacher is standing when they open the
# window, instead of on a surveyed coordinate. Set false to always use
# the classroom's saved latitude/longitude.
ANCHOR_ON_TEACHER_LOCATION=true

# A live anchor has its own error, forgiven on top of the student's --
# otherwise two phones side by side can read far enough apart that the
# student is rejected for the teacher's GPS noise.
ANCHOR_ACCURACY_CREDIT_METERS=25

# An anchor vaguer than this puts the circle in the wrong part of the
# building, so it is refused and the saved coordinates are used.
MAX_ANCHOR_ACCURACY_METERS=30

# --- Teacher-controlled window ---
DEFAULT_WINDOW_SECONDS=120
MAX_WINDOW_SECONDS=300

# --- Rotating QR token ---
# Displayed for 30s, accepted for 35s so a submission that lands just
# after a rotation still succeeds. New sessions pick these up; sessions
# already created keep the timing they were created with.
TOKEN_ROTATION_SECONDS=30
TOKEN_TTL_SECONDS=35

# --- Anti-proxy ---
# Both must be true in a real deployment. Turning either off is what the
# app warns about on startup.
ENFORCE_NETWORK_CHECK=true
ENFORCE_DEVICE_BINDING=true
DEVICE_COOKIE_NAME=att_device

# Number of proxies in front of the app. Leave at 0 unless you control
# them: trusting X-Forwarded-For lets any student claim to be on the
# classroom network.
TRUSTED_PROXY_COUNT=0

# --- Rate limiting ---
MAX_ATTEMPTS_PER_SESSION=10

# Set to true once you are serving over HTTPS.
SESSION_COOKIE_SECURE=false
